# イマノウチ — 環境変数のひな形
#
# ローカル開発ではリポジトリ直下に .env を置く（pnpm dev が --env-file-if-exists で読む）。
# 本番は enebular の実行環境の envVars にコンソールから設定する。
# ★ 値の入ったファイルをリポジトリにコミットしないこと。
#   CI が知るシークレットは enebular のアクセスキーだけにする。

# --- LINE ログイン（FR-01） --------------------------------------------
# LIFF ID。LINE Developers コンソールのミニアプリチャネル →「ウェブアプリ設定」で確認する。
#
# ★ ミニアプリは1チャネルにつき内部チャネルが3つ（開発用・審査用・本番用）作られ、
#   **LIFF ID もチャネルIDも内部チャネルごとに別**である。
#   コンソールには LIFF URL（https://miniapp.line.me/<LIFF ID>）として出るので、
#   **パスの部分**を設定する。デプロイ先に対応するものを選ぶこと。
LIFF_ID=change-me

# チャネル ID。「チャネル基本設定」→ 基本情報で確認する。
#
# ★ LIFF ID と同じく**内部チャネルごとに別の値**である。
# ★ LIFF ID は `<チャネルID>-<ランダム文字列>` という形なので、
#   LIFF_ID の先頭がこの値と一致していなければ組み合わせが間違っている。
#   起動時に検査し、合っていなければ /v1/health の configOk が false になる。
#
#   例（開発用）: LIFF_ID=2011183531-CoJerXk1 / LINE_CHANNEL_ID=2011183531
#
# ★ IDトークン検証で aud の照合に使い、LINE の検証エンドポイントの client_id にも渡す。
#   一致しないと 401 になる。理由は実行環境のログに出る
#   （[auth] line verify failed: audience mismatch）。
LINE_CHANNEL_ID=change-me

# 自前セッショントークンの署名鍵。
# ★ 推測できない十分に長い値にすること。漏れると誰でも他人になれる。
#   生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me

# セッションの有効時間（時間）。切れたら LIFF から取り直す。
SESSION_TTL_HOURS=12

# --- 地図 ---------------------------------------------------------------
# Mapbox の公開トークン（pk. で始まるもの）。ブラウザへ配信されるため、
# Mapbox のコンソールで URL 制限をかけたトークンを使うこと。
MAPBOX_ACCESS_TOKEN=change-me

# --- 管理 ---------------------------------------------------------------
# POST /v1/admin/seed を叩くための鍵。スポットの投入だけに使う。
#
# ★ 例をどこかから写さないこと。人目に触れた文字列は鍵として使えない。
#   生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# ★ base64url（A-Za-z0-9-_）で出すのは、HTTP ヘッダに素で載せられて
#   curl でも引用符が要らないため。記号入りにすると貼り間違いが増える。
#
# ★ SESSION_SECRET と同じ値にしないこと。用途が違い、漏れたときの影響が違う。
#   change-me と 00000000-... は「未設定」として扱われる。
ADMIN_KEY=change-me

# --- 利用状況の計測（#82） ----------------------------------------------
# GA4 の測定ID（G-XXXXXXXX の形）。**任意である。**
#
# ★ 未設定なら計測タグを1バイトも出さない。ローカル開発では設定しないこと
#   （手元の操作が本番の数字に混ざる）。
# ★ 形が違う値は未設定として扱い、起動時ログに警告が出る。打ち間違いを黙って
#   通すと「計測しているつもりで何も取れていない」になるため。
# ★ /v1/health の configOk には影響しない（必須ではないので、これでデプロイの
#   スモークテストを落とさない）。
# ★ タグは index.html と dashboard.html へ配信時に差し込む。**HTML にも
#   バンドルにも測定IDは入らない**ので、デプロイなしで止められる。
# ★ 送る内容は apps/web/src/analytics.ts にある。userId・表示名・緯度経度・
#   スポットの個別IDは送らない。
GA_MEASUREMENT_ID=

# --- データストア（enebular コンソールで作成したテーブルの UUID） -------
# キー名は docs/deploy.md の表のとおりに作る。
DS_TABLE_SPOTS=00000000-0000-0000-0000-000000000000
DS_TABLE_USERS=00000000-0000-0000-0000-000000000000
# ★ FR-02-7（歩いたところ）で追加。メインキー userKey / サブキー tileKey、どちらも文字列。
#   これが無いと /v1/exploration だけが 500 になる（他は正常に見えるので気づきにくい）。
DS_TABLE_EXPLORED_TILES=00000000-0000-0000-0000-000000000000

# FR-03 チェックイン履歴。メインキー userKey / サブキー checkinAt
# ★★ サブキーは必ず「数値」で作る。文字列にすると範囲クエリが辞書順になり、
#     桁が上がった時点で「新しい順」が壊れる。作り直すしか直せない。
DS_TABLE_CHECKINS=00000000-0000-0000-0000-000000000000
# FR-03・FR-04 が共有。メインキー userKey / サブキー spotKey、どちらも文字列。
# 最終チェックイン時刻・訪問回数・クイズ正解時刻を1レコードにまとめる。
# ★ クイズ用に別テーブルを作らない（アイテム数を増やさないため）。
# ★ これが無いと /v1/spots/:id/checkin と /v1/spots/:id/quiz だけが 500 になる。
DS_TABLE_USER_SPOT_STATE=00000000-0000-0000-0000-000000000000

# FR-07・FR-14（ポイントの出口・カード収集）。メインキー userKey / サブキー itemKey、文字列。
# ★ サブキーには `<種類>:<キー>`（例 place:aed-277fdb2594）が入る。アイテム用の
#   テーブルを流用してカードの識別子へ一般化してあるので、カード用に別のテーブルは作らない。
# ★ これが無いとチェックインとクイズが 500 になる（カードの達成処理が通らない）。
DS_TABLE_USER_CARDS=00000000-0000-0000-0000-000000000000

# --- スポットデータの出どころ -------------------------------------------
# opendata: 取込スクリプト（pnpm ingest）が生成した実データ。既定
# sample  : 動作確認用の架空データ
# ★ 画面に出典が出るので、どちらで動いているかは常に分かる。
SEED_DATASET=opendata

# --- 対象エリア ---------------------------------------------------------
# 千代田区・港区を1つのパーティションにまとめる（#6 決着）。区ごとに分けない。
AREA_ID=chiyoda-minato
AREA_NAME=千代田区・港区
# 両区の境界（新橋〜虎ノ門〜霞ヶ関）付近。★撮影ルート確定後に合わせる（FR-10-5）
AREA_CENTER_LAT=35.6690
AREA_CENTER_LNG=139.7530
AREA_ZOOM=14

# --- チェックイン・クイズ（FR-03・FR-04） -------------------------------
# チェックインできる半径（m）。FR-03-1 の「例：100m」。
# ★ 判定はサーバーで行う。この値はクライアントへも配られるが、それは
#   「遠いのに押せるボタンを出さない」ためだけで、書き換えても判定は変わらない。
CHECKIN_RADIUS_M=100

# 同一スポットへの再チェックイン制限（時間）。FR-03-3 の「例：24時間」。
# ★ デモで何度も見せたいときは小さくする（0 にすると制限なし）。
#   おためし利用では端末の記録で抑えるため、サーバー側では効かない。
CHECKIN_COOLDOWN_HOURS=24

# クイズ正解のボーナスポイント（FR-04-3）。
# ★ チェックインの基礎点（10pt・packages/core/src/checkin.ts）より大きくしている。
#   現地で考えることに報いるのが目的で、通り過ぎるだけで同じ点が入ると意味がない。
QUIZ_CORRECT_POINTS=30

# --- 現地確認アンケート（FR-12） ----------------------------------------
#
# ★ この設問群が、このサービスが集めているデータの実体である。チェックインと
#   クイズは行政データを1件も増やさない。要点 P-1（行政データの不足を補う）と
#   競争優位 UA-1（超低コストのデータ収集）は、この経路が回ることに依存する。
#
# ★ 専用のテーブルは要らない（DS_TABLE_* を増やしていない）。集計はスポットの行に
#   事前計算して持ち、本人の回答は user_spot_state に入れている（制約 E2・E4）。

# 回答1回あたりの基礎点。
# ★ チェックイン（10pt）より大きくしている。立ち止まって設備を見ることが
#   集めたいものであり、通り過ぎるだけと同じ点なら誰も答えない（G-6）。
SURVEY_BASE_POINTS=20

# 「行政データが空の項目」1件あたりの上乗せ（FR-12-4）。
# ★ **答えの中身では変わらない。** 「はい／いいえ」に加点して「わからない」に
#   加点しない形にすると、分からないのに断定する動機を作り、公開データの精度を
#   そのまま落とす。倍率はスポット側の欠損数だけで決める。
# ★ 属性が1件も無い AED（224件）は 20+5×3=35 点、記載のある避難所は 30 点になる。
#   空いているところへ行くほうが得、という向きを点数で作っている。
SURVEY_FILL_BONUS_POINTS=5

# 項目を「検証済み」にするのに必要な、同じ答えの数（FR-06-2）。
# ★ **1 にしてはいけない。** 報酬つきのアンケートは必ず「適当に答えて報酬」を
#   生む。独立した2人が同じ答えを出したときに初めて確定させる（UA-2 の実体）。
#   デモで確定の様子を見せたいときだけ 1 に落とす。
SURVEY_CONSENSUS_COUNT=2

# --- 上限 ---------------------------------------------------------------
MAX_SPOTS_PER_REQUEST=200
RATE_LIMIT_PER_MINUTE=60

# デモ用の移動操作（ジョイスティック）を許すか。
# ★ true でも LINE アプリ内では表示されない（画面側が判定する）。
#   PC のブラウザか、位置情報が取れない環境でのみ出る。
#   URL が漏れたときに、デプロイなしで止められるようにするためのスイッチ。
ENABLE_DEBUG_MOVE=true

# 有事モード（FR-08）への切替ボタンを出すか。
# ★ デモ用である。実利用者に見せると、実際に災害が起きたと誤認させうる。
#   画面には常に「デモ表示であり実際の災害情報ではない」と出しているが、
#   実運用へ配るときはここを false にして切替そのものを消す。
ENABLE_EMERGENCY_DEMO=true

# LINE ログインなしの「おためし」を許すか。
# ★ 発行するのは読み取り専用のセッションで、スポットの参照しか通らない。
#   歩いた記録・同意・キャラクターは端末の中だけに置き、サーバーへは書かない。
#   トークンの発行そのものは誰でも叩けるため、公開範囲を絞りたい場合は false にする。
ENABLE_GUEST_MODE=true

# --- ローカル専用 -------------------------------------------------------
# データストアはローカルで代替できないため、インメモリ実装を使う
USE_FAKE_DATASTORE=true

# 開発用ログイン（ローカルの動作確認専用）。
#
# ★ **本番には設定しないこと。**
# ★ そもそも `USE_FAKE_DATASTORE` が真のときしか経路が生えないので、これだけを
#   設定しても本番では 404 になる（二重の鍵にしてある）。
# ★ 何のためにあるか：LIFF はエンドポイント URL に公開URLを登録した状態で LINE
#   アプリから開く必要があるため、**ローカルでは LINE ログインが完走しない。**
#   結果、ログインが要る機能（チェックインの保存・カード）を手元で確かめられない。
# ★ ローカル起動（pnpm dev）は自分で true にするので、通常は設定不要である。
ENABLE_DEV_LOGIN=false

# --- 探索（FR-02-7） ---------------------------------------------------
# 記録の粒度（m 四方）。小さくすると軌跡は滑らかになるが、書き込みが面積比で増える。
EXPLORE_TILE_SIZE_M=50

# 地図上で霧を晴らす半径（m）。
# ★ タイルより大きくすること。同じ大きさだと隣り合うタイルの間に霧が残り、軌跡が途切れて見える。
EXPLORE_REVEAL_RADIUS_M=40

# 町丁目が開放される割合。中央値の町丁目は35タイルなので、25%＝9枚。
EXPLORE_UNLOCK_RATIO=0.25

# 開放に必要なタイル数の上限。
# ★ 町丁目は最大1433タイルあり、割合だけだと広い区画が一生開かない。
EXPLORE_UNLOCK_MAX_TILES=12

# 探索率の分母になる対象エリアの半径（m）。★撮影ルートの中心に合わせる（FR-10-5）。
AREA_RADIUS_M=1500

MAX_EXPLORED_TILES_PER_REQUEST=2000

# --- 生成AI（OrcaRouter・#75） --------------------------------------
# ★ **役割で二段に分ける**（提出物 3-2）。OrcaRouter は OpenAI 互換のゲートウェイと
#   してだけ使い、**難易度による動的な振り分けは使わない。** モデルは呼ぶ側が固定する。
#   動的に振り分けると「取り込み時だけ高性能モデル」という費用構造の説明が崩れる。
#
# ★ 設定しなくてもアプリは動く。クイズは固定データのまま出る。
#   「設定されていない」と「壊れている」を混ぜないための作りにしてある。
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1

# ★ **鍵。コミットしないこと。** BYOK（自分の provider の鍵を OrcaRouter に預ける）
#   なので、上流の課金は provider から直接来る。
ORCAROUTER_API_KEY=

# 取り込み時に使う高性能モデル。**呼ぶのは `pnpm build:kb --expand` のときだけ。**
# 実行時にこれを呼んではいけない（コストが利用者数に比例してしまう）。
AI_INGEST_MODEL=claude-opus-5

# 利用時に使う軽量モデル。整ったナレッジだけを材料にクイズの言い回しを作る。
AI_RUNTIME_MODEL=gemini-2.5-flash

# 応答を待つ上限（ms）。★ 必ず打ち切る。返らないと Lambda は課金され続け、
#   利用者の画面はクイズが出ないまま止まる。
AI_TIMEOUT_MS=60000
