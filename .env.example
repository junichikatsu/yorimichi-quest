# イマノウチ — 環境変数のひな形
#
# ローカル開発ではリポジトリ直下に .env を置く（pnpm dev が --env-file-if-exists で読む）。
# 本番は enebular の実行環境の envVars にコンソールから設定する。
# ★ 値の入ったファイルをリポジトリにコミットしないこと。
#   CI が知るシークレットは enebular のアクセスキーだけにする。

# --- LINE ログイン（FR-01） --------------------------------------------
# LIFF ID。LINE Developers コンソールのミニアプリチャネル →「ウェブアプリ設定」で確認する。
#
# ★ ミニアプリは1チャネルにつき内部チャネルが3つ（開発用・審査用・本番用）作られ、
#   **LIFF ID もチャネルIDも内部チャネルごとに別**である。
#   コンソールには LIFF URL（https://miniapp.line.me/<LIFF ID>）として出るので、
#   **パスの部分**を設定する。デプロイ先に対応するものを選ぶこと。
LIFF_ID=change-me

# チャネル ID。「チャネル基本設定」→ 基本情報で確認する。
#
# ★ LIFF ID と同じく**内部チャネルごとに別の値**である。
# ★ LIFF ID は `<チャネルID>-<ランダム文字列>` という形なので、
#   LIFF_ID の先頭がこの値と一致していなければ組み合わせが間違っている。
#   起動時に検査し、合っていなければ /v1/health の configOk が false になる。
#
#   例（開発用）: LIFF_ID=2011183531-CoJerXk1 / LINE_CHANNEL_ID=2011183531
#
# ★ IDトークン検証で aud の照合に使い、LINE の検証エンドポイントの client_id にも渡す。
#   一致しないと 401 になる。理由は実行環境のログに出る
#   （[auth] line verify failed: audience mismatch）。
LINE_CHANNEL_ID=change-me

# 自前セッショントークンの署名鍵。
# ★ 推測できない十分に長い値にすること。漏れると誰でも他人になれる。
#   生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me

# セッションの有効時間（時間）。切れたら LIFF から取り直す。
SESSION_TTL_HOURS=12

# --- 地図 ---------------------------------------------------------------
# Mapbox の公開トークン（pk. で始まるもの）。ブラウザへ配信されるため、
# Mapbox のコンソールで URL 制限をかけたトークンを使うこと。
MAPBOX_ACCESS_TOKEN=change-me

# --- 管理 ---------------------------------------------------------------
# POST /v1/admin/seed を叩くための鍵。スポットの投入だけに使う。
#
# ★ 例をどこかから写さないこと。人目に触れた文字列は鍵として使えない。
#   生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# ★ base64url（A-Za-z0-9-_）で出すのは、HTTP ヘッダに素で載せられて
#   curl でも引用符が要らないため。記号入りにすると貼り間違いが増える。
#
# ★ SESSION_SECRET と同じ値にしないこと。用途が違い、漏れたときの影響が違う。
#   change-me と 00000000-... は「未設定」として扱われる。
ADMIN_KEY=change-me

# --- データストア（enebular コンソールで作成したテーブルの UUID） -------
# キー名は docs/deploy.md の表のとおりに作る。
DS_TABLE_SPOTS=00000000-0000-0000-0000-000000000000
DS_TABLE_USERS=00000000-0000-0000-0000-000000000000
# ★ FR-02-7（歩いたところ）で追加。メインキー userKey / サブキー tileKey、どちらも文字列。
#   これが無いと /v1/exploration だけが 500 になる（他は正常に見えるので気づきにくい）。
DS_TABLE_EXPLORED_TILES=00000000-0000-0000-0000-000000000000

# --- 以降の FR で使うテーブル（先に作っておける） -----------------------
# ★ コードはまだ要求しない（必須にすると configOk が false になる）。
#   テーブルと値を先に用意しておけば、実装が入った時点でそのまま動く。
#
# FR-03 チェックイン。メインキー userKey / サブキー checkinAt
# ★★ サブキーは必ず「数値」で作る。文字列にすると範囲クエリが辞書順になり、
#     桁が上がった時点で「新しい順」が壊れる。作り直すしか直せない。
# DS_TABLE_CHECKINS=00000000-0000-0000-0000-000000000000
#
# FR-03・FR-04 が共有。メインキー userKey / サブキー spotKey、どちらも文字列。
# 最終チェックイン時刻・訪問回数・クイズ正解時刻を1レコードにまとめる。
# ★ クイズ用に別テーブルを作らない（アイテム数を増やさないため）。
# DS_TABLE_USER_SPOT_STATE=00000000-0000-0000-0000-000000000000
#
# FR-07・FR-14（ポイントの出口・カード収集）。メインキー userKey / サブキー itemKey、文字列。
# DS_TABLE_USER_CARDS=00000000-0000-0000-0000-000000000000

# --- スポットデータの出どころ -------------------------------------------
# opendata: 取込スクリプト（pnpm ingest）が生成した実データ。既定
# sample  : 動作確認用の架空データ
# ★ 画面に出典が出るので、どちらで動いているかは常に分かる。
SEED_DATASET=opendata

# --- 対象エリア ---------------------------------------------------------
# 千代田区・港区を1つのパーティションにまとめる（#6 決着）。区ごとに分けない。
AREA_ID=chiyoda-minato
AREA_NAME=千代田区・港区
# 両区の境界（新橋〜虎ノ門〜霞ヶ関）付近。★撮影ルート確定後に合わせる（FR-10-5）
AREA_CENTER_LAT=35.6690
AREA_CENTER_LNG=139.7530
AREA_ZOOM=14

# --- 上限 ---------------------------------------------------------------
MAX_SPOTS_PER_REQUEST=200
RATE_LIMIT_PER_MINUTE=60

# デモ用の移動操作（ジョイスティック）を許すか。
# ★ true でも LINE アプリ内では表示されない（画面側が判定する）。
#   PC のブラウザか、位置情報が取れない環境でのみ出る。
#   URL が漏れたときに、デプロイなしで止められるようにするためのスイッチ。
ENABLE_DEBUG_MOVE=true

# 有事モード（FR-08）への切替ボタンを出すか。
# ★ デモ用である。実利用者に見せると、実際に災害が起きたと誤認させうる。
#   画面には常に「デモ表示であり実際の災害情報ではない」と出しているが、
#   実運用へ配るときはここを false にして切替そのものを消す。
ENABLE_EMERGENCY_DEMO=true

# --- ローカル専用 -------------------------------------------------------
# データストアはローカルで代替できないため、インメモリ実装を使う
USE_FAKE_DATASTORE=true

# --- 探索（FR-02-7） ---------------------------------------------------
# 記録の粒度（m 四方）。小さくすると軌跡は滑らかになるが、書き込みが面積比で増える。
EXPLORE_TILE_SIZE_M=50

# 地図上で霧を晴らす半径（m）。
# ★ タイルより大きくすること。同じ大きさだと隣り合うタイルの間に霧が残り、軌跡が途切れて見える。
EXPLORE_REVEAL_RADIUS_M=40

# 町丁目が開放される割合。中央値の町丁目は35タイルなので、25%＝9枚。
EXPLORE_UNLOCK_RATIO=0.25

# 開放に必要なタイル数の上限。
# ★ 町丁目は最大1433タイルあり、割合だけだと広い区画が一生開かない。
EXPLORE_UNLOCK_MAX_TILES=12

# 探索率の分母になる対象エリアの半径（m）。★撮影ルートの中心に合わせる（FR-10-5）。
AREA_RADIUS_M=1500

MAX_EXPLORED_TILES_PER_REQUEST=2000
