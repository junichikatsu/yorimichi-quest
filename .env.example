# イマノウチ — 環境変数のひな形
#
# ローカル開発ではリポジトリ直下に .env を置く（pnpm dev が --env-file-if-exists で読む）。
# 本番は enebular の実行環境の envVars にコンソールから設定する。
# ★ 値の入ったファイルをリポジトリにコミットしないこと。
#   CI が知るシークレットは enebular のアクセスキーだけにする。

# --- LINE ログイン（FR-01） --------------------------------------------
# LIFF ID。LINE Developers コンソールのミニアプリチャネル →「ウェブアプリ設定」で確認する。
#
# ★ ミニアプリは1チャネルにつき内部チャネルが3つ（開発用・審査用・本番用）作られ、
#   **LIFF ID は内部チャネルごとに別**である。デプロイ先に対応するものを設定すること。
#   取り違えると、開発用の URL を本番の LIFF から開くことになり原因が分かりにくい。
LIFF_ID=change-me

# チャネル ID。「チャネル基本設定」で確認する。
#
# ★ LIFF ID と違い、**内部チャネル3つで共通**である（開発用・本番用で変えない）。
# ★ IDトークン検証で aud の照合に使う。LINE の検証エンドポイントの client_id にも渡す。
#   一致しないと 401 になる。設定ミスの理由は実行環境のログに出る
#   （[auth] line verify failed: audience mismatch）。
LINE_CHANNEL_ID=change-me

# 自前セッショントークンの署名鍵。
# ★ 推測できない十分に長い値にすること。漏れると誰でも他人になれる。
#   生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me

# セッションの有効時間（時間）。切れたら LIFF から取り直す。
SESSION_TTL_HOURS=12

# --- 地図 ---------------------------------------------------------------
# Mapbox の公開トークン（pk. で始まるもの）。ブラウザへ配信されるため、
# Mapbox のコンソールで URL 制限をかけたトークンを使うこと。
MAPBOX_ACCESS_TOKEN=change-me

# --- 管理 ---------------------------------------------------------------
# POST /v1/admin/seed を叩くための鍵。推測できない値にする。
ADMIN_KEY=change-me

# --- データストア（enebular コンソールで作成したテーブルの UUID） -------
DS_TABLE_SPOTS=00000000-0000-0000-0000-000000000000
DS_TABLE_USERS=00000000-0000-0000-0000-000000000000

# --- スポットデータの出どころ -------------------------------------------
# opendata: 取込スクリプト（pnpm ingest）が生成した実データ。既定
# sample  : 動作確認用の架空データ
# ★ 画面に出典が出るので、どちらで動いているかは常に分かる。
SEED_DATASET=opendata

# --- 対象エリア ---------------------------------------------------------
# 千代田区・港区を1つのパーティションにまとめる（#6 決着）。区ごとに分けない。
AREA_ID=chiyoda-minato
AREA_NAME=千代田区・港区
# 両区の境界（新橋〜虎ノ門〜霞ヶ関）付近。★撮影ルート確定後に合わせる（FR-10-5）
AREA_CENTER_LAT=35.6690
AREA_CENTER_LNG=139.7530
AREA_ZOOM=14

# --- 上限 ---------------------------------------------------------------
MAX_SPOTS_PER_REQUEST=200
RATE_LIMIT_PER_MINUTE=60

# --- ローカル専用 -------------------------------------------------------
# データストアはローカルで代替できないため、インメモリ実装を使う
USE_FAKE_DATASTORE=true
