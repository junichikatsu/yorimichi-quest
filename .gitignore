node_modules/
.turbo/

# 生成物
apps/web/public/app.js
apps/web/public/app.css
apps/function/build/
apps/function/*.zip

# 環境変数（値の入ったファイルはコミットしない）
.env
.env.*
!.env.example

# 取込スクリプトのダウンロードキャッシュ（避難所CSVが13MBあるためコミットしない）
tools/ingest/.cache/

# 提出したプレゼン資料（pptx が10MB超あるためコミットしない。置き場所は doc/submission-final/assets/README.md）
doc/submission-final/assets/*.pptx
