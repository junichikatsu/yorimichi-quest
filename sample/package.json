{
  "name": "yorimichi-sample",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "YORIMICHI QUEST サンプル地図アプリ（enebular クラウド実行環境 / Mapbox / React）",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @yorimichi-sample/function dev",
    "dev:web": "pnpm --filter @yorimichi-sample/web dev",
    "build:web": "pnpm --filter @yorimichi-sample/web build",
    "build:zip": "pnpm --filter @yorimichi-sample/function build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build:zip"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "turbo": "^2.5.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
