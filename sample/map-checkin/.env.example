# YORIMICHI QUEST サンプル — 環境変数のひな形
#
# ローカル開発では sample/map-checkin/.env に置く（pnpm dev が --env-file-if-exists で読む）。
# enebular では実行環境の envVars にコンソールから設定する。
# ★ 値の入ったファイルをリポジトリにコミットしないこと。
#   CI が知るシークレットは enebular のアクセスキーだけにする。

# --- 地図 ---------------------------------------------------------------
# Mapbox の公開トークン（pk. で始まるもの）。ブラウザへ配信されるため、
# Mapbox のコンソールで URL 制限をかけたトークンを使うこと。
MAPBOX_ACCESS_TOKEN=change-me

# --- 管理 ---------------------------------------------------------------
# POST /v1/admin/seed を叩くための鍵。推測できない値にする。
ADMIN_KEY=change-me

# --- データストア（enebular コンソールで作成したテーブルの UUID） -------
DS_TABLE_SPOTS=00000000-0000-0000-0000-000000000000
DS_TABLE_USERS=00000000-0000-0000-0000-000000000000
DS_TABLE_CHECKINS=00000000-0000-0000-0000-000000000000
DS_TABLE_USER_SPOT_STATE=00000000-0000-0000-0000-000000000000
DS_TABLE_EXPLORED_TILES=00000000-0000-0000-0000-000000000000

# --- 対象エリア（デモ用の初期表示） -------------------------------------
AREA_ID=chiyoda
AREA_NAME=千代田区周辺（サンプルエリア）
AREA_CENTER_LAT=35.6785
AREA_CENTER_LNG=139.7594
AREA_ZOOM=14
# 探索率の分母。エリア中心からこの半径の円を「探索の対象範囲」とみなす
AREA_RADIUS_M=1500

# --- ゲームパラメータ（暫定値。確定は Issue #7） ------------------------
CHECKIN_RADIUS_M=100
CHECKIN_COOLDOWN_HOURS=24
# 歩いた場所を記録する粒度（m）。小さくすると軌跡は滑らかになるが書き込みが増える
EXPLORE_TILE_SIZE_M=50
# 地図上で霧を晴らす半径（m）。タイルより大きくしないと軌跡が途切れて見える
EXPLORE_REVEAL_RADIUS_M=40
MAX_SPOTS_PER_REQUEST=200
MAX_EXPLORED_TILES_PER_REQUEST=2000
RATE_LIMIT_PER_MINUTE=60

# --- 動作モード ---------------------------------------------------------
# true にすると Mapbox トークン無しでも起動し、一覧表示にフォールバックする
MOCK_MODE=false
# true にするとインメモリのデータストアを使う（ローカル開発用。enebular では false）
USE_FAKE_DATASTORE=false
# DEBUG 以上は入力内容がログに出うるため、既定は INFO
LOG_LEVEL=INFO

# ローカル起動ポート
PORT=8787
